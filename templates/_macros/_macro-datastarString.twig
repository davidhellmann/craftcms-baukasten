{##
 # Generate a random string
 #
 # @param int length - Length of the random string (default: 10)
 # @return string - Random string with numbers and letters (a-z, A-Z, 0-9)
 #
 # Usage:
 # {% import '_macros/_macro-datastarString.twig' as randomString %}
 # {{ randomString.generate(10) }}
 #}

{% macro generate(context = "") %}
  {%- set chars = 'abcdefghijklmnopqrstuvwxyz0123456789'|split('') -%}
  {%- set result = context | replace({" ": "", "-": "_"}) | lower ~ "_"-%}
  {%- for i in 1..6 -%}
    {%- set result = result ~ random(chars) -%}
  {%- endfor -%}
  {{- result | lower -}}
{% endmacro %}
