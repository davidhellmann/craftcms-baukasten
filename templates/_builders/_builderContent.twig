{% import '_macros/_macro-mergeProps.twig' as mergeProps %}
{% set compDefaults = {
  name: 'c-builderContent',
  builderContent: null,
  classes: {
    root: '',
    custom: '',
  },
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}

{% if props.builderContent %}
  <div class="{{ props.name }} {{ props.classes.root }} {{ props.classes.custom }}">
    {% for block in props.builderContent %}
      {{ include('entryTypes/_routerBlocks.twig', {
        block: block ??? null,
      }, withContext = false) }}
    {% endfor %}
  </div>
{% endif %}
