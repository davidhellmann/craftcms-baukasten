{% set compDefaults = {
  name: 'c-builderContent',
  builderContent: null,
  classes: {
    root: '',
    custom: '',
  },
} %}

{% set props = compDefaults
  | merge(props|default({}))
  | merge({ classes: compDefaults.classes | merge(classes|default({})) })
%}

{% if props.builderContent %}
  <div class="{{ props.name }} {{ props.classes.root }} {{ props.classes.custom }}">
    {% for block in props.builderContent %}
      {{ include('entryTypes/_routerBlocks.twig', {
        block: block ??? null,
      }, withContext = false) }}
    {% endfor %}
  </div>
{% endif %}
