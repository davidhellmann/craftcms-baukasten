{% set compDefaults = {
  url: siteUrl,
  name: 'footer',
  classes: {
    root: 'bg-gray-100  mt-auto',
    custom: '',
    container: 'container py-4 text-sm',
    footerLink: 'underline hover:no-underline font-bold'
  }
} %}

{% set props = compDefaults
  | merge(props|default({}))
  | merge({ classes: compDefaults.classes | merge(classes|default({})) })
%}

<footer data-slot="{{ props.name }}"
        class="{{ props.classes.root }} {{ props.classes.custom }}">
  <div class="{{ props.classes.container }}">
    <a class="{{ props.classes.footerLink }}"
       href="{{ props.url }}">Baukasten</a> &copy;2014 &mdash; {{ "now"|date("Y") }}
  </div>
</footer>
