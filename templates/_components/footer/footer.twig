{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{% set compDefaults = {
  url: siteUrl,
  name: 'c-footer',
  classes: {
    root: 'bg-gray-100  mt-auto',
    custom: '',
    container: 'container py-4 text-sm',
    footerLink: 'underline hover:no-underline font-bold'
  }
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}

<footer class="{{ props.name }} {{ props.classes.root }} {{ props.classes.custom }}">
  <div class="{{ props.classes.container }}">
    <a class="{{ props.classes.footerLink }}" href="{{ props.url }}">Baukasten</a> &copy;2014 &mdash; {{ "now"|date("Y") }}
  </div>
</footer>
