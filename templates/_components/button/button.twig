{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{% set compDefaults = {
  name: 'c-button',
  variantStyle: 'primary',
  variantSize: 'md',
  icon: null,
  iconSize: 'sm',
  text: null,
  url: null,
  buttonType: 'button',
  reverse: false,
  target: null,
  enlargeClickArea: false,
  classes: {
    root: 'a11y-keyboard-focus items-center font-bold',
    custom: '',
    display: 'inline-flex',
    rounded: 'rounded-md',
    enlargeClickArea: 'enlarge-click-area'
  },
  variants: {
    style: {
      primary: 'text-white border border-transparent bg-primary-700 hover:bg-primary-800 group-hover:bg-primary-800',
      secondary: 'text-secondary-900 border border-transparent bg-secondary-300 hover:bg-secondary-400 group-hover:bg-secondary-400',
      outlined: 'text-gray-900 border border-transparent border-gray-200 bg-white hover:bg-gray-50 group-hover:bg-gray-50',
      overflowNav: 'text-gray-900 border-b-2 border-b-transparent hover:border-b-gray-900 !rounded-none',
    },
    size: {
      sm: 'px-2.5 py-1.5 gap-2 text-xs',
      md: 'px-4 py-2 gap-3 text-base',
      lg: 'px-6 py-3 gap-4 text-base',
      overflowNav: 'py-1 gap-3 text-xs',
    }
  }
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}

{% if props.text or props.icon %}
  {% set as = props.url ? 'a' : 'button' %}
  {% set attr = props.url ? 'href=' ~ props.url : 'type=' ~ props.buttonType %}

  <{{ as }} {{ attr }} {{ props.url and props.target ? 'target=' ~ props.target : '' }}
      class="{{ props.name }} {{ props.classes.root }} {{ props.classes.rounded }} {{ props.classes.display }} {{ props.variants.style[props.variantStyle] }}  {{ props.variants.size[props.variantSize] }} {{ props.classes.custom }} {{ props.enlargeClickArea ? props.classes.enlargeClickArea : '' }}">

  {# >>> If icon exists #}
  {% if props.icon %}
    {# >>> Render icon  #}
    {{ include('_components/icon/icon.twig', {
      props: {
        icon: props.icon ??? null,
        fill: 'solid',
        variantSize: props.iconSize
      },
      classes: {
        custom: (props.reverse ? 'order-2' : '')
      }
    }, withContext = false) }}
  {% endif %}
    {{ props.text ??? null }}
  </{{ as }}>
{% endif %}
