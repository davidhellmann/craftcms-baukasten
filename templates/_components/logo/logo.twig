{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{% set compDefaults = {
  name: "c-logo",
  svgName: "logo",
  variantSize: "md",
  classes: {
    root: "",
    custom: ""
  },
  variants: {
    size: {
      sm: "w-8 h-8",
      md: "w-16 h-16",
      lg: "w-24 h-24"
    }
  }
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}

{% if props.svgName %}
  {{
    svg("@webroot/dist/images/svg/" ~ props.svgName ~ ".svg")|attr({
      class: props.name ~ " " ~ props.classes.root ~ " " ~ props.variants.size[props.variantSize] ~ " "
        ~ props.classes.custom
    })
  }}
{% endif %}
