{% set compDefaults = {
  name: "logo",
  svgName: "logo",
  variantSize: "md",
  classes: {
    root: "",
    custom: ""
  },
  variants: {
    size: {
      sm: "w-8 h-8",
      md: "w-16 h-16",
      lg: "w-24 h-24"
    }
  }
} %}

{% set props = compDefaults
  | merge(props|default({}))
  | merge({ classes: compDefaults.classes | merge(classes|default({})) })
%}

{% if props.svgName %}
  {{
    svg("@webroot/dist/images/svg/" ~ props.svgName ~ ".svg")|attr({
      'data-slot': props.name,
      class: props.classes.root ~ " " ~ props.variants.size[props.variantSize] ~ " "
        ~ props.classes.custom
    })
  }}
{% endif %}
