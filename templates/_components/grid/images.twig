{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{% set compDefaults = {
  name: 'c-imageGrid',
  images: null,
  lazy: true,
  caption: null,
  aspectRatio: 'aspect-landscape',
  columns: 2,
  classes: {
    root: 'grid grid-cols-1 gap-4 md:gap-8',
    custom: '',
  },
  variants: {
    columns: {
      2: 'md:grid-cols-2',
      3: 'md:grid-cols-3'
    }
  }
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}

{% if props.images ??? null %}
  <div class="{{ props.name }}  {{ props.classes.root }}  {{ props.variants.columns[props.columns] }} {{ props.classes.custom }}">
    {% for image in props.images %}
      {{ include('_components/image/image.twig', {
        data: {
          image: image ??? null,
          aspectRatio: props.aspectRatio ??? null,
          caption: props.caption ??? null,
          lazy: props.lazy
        },
        classes: {
          custom: 'col-span-1'
        }
      }, withContext = false) }}
    {% endfor %}
  </div>
{% endif %}
