{% set compDefaults = {
  name: 'image-grid',
  images: null,
  lazy: true,
  caption: null,
  aspectRatio: 'aspect-landscape',
  columns: 2,
  classes: {
    root: 'grid grid-cols-1 gap-4 md:gap-8',
    custom: '',
  },
  variants: {
    columns: {
      2: 'md:grid-cols-2',
      3: 'md:grid-cols-3'
    }
  }
} %}

{% set props = compDefaults
  | merge(props|default({}))
  | merge({ classes: compDefaults.classes | merge(classes|default({})) })
%}

{% if props.images ??? null %}
  <div data-slot="{{ props.name }}"
       class="{{ props.classes.root }}  {{ props.variants.columns[props.columns] }} {{ props.classes.custom }}">
    {% for image in props.images %}
      {{ include('_components/image/image.twig', {
        props: {
          image: image ??? null,
          aspectRatio: props.aspectRatio ??? null,
          caption: props.caption ??? null,
          lazy: props.lazy
        },
        classes: {
          custom: 'col-span-1'
        }
      }, withContext = false) }}
    {% endfor %}
  </div>
{% endif %}
