{% set compDefaults = {
  name: 'image-grid-calculated',
  images: null,
  lazy: true,
  caption: null,
  classes: {
    root: 'flex flex-col md:flex-row flex-nowrap gap-4 md:gap-8',
    custom: '',
  },
} %}

{% set props = compDefaults
  | merge(props|default({}))
  | merge({ classes: compDefaults.classes | merge(classes|default({})) })
%}

{% if props.images ??? null %}
  <div
    data-slot="{{ props.name }}"
    data-css="{{ props.name }}"
    class="{{ props.classes.root }} {{ props.classes.custom }}">
    {% for image in props.images %}
      <div style="--ratio: {{ image.width }} / {{ image.height }}">
        {{ include('_components/image/image.twig', {
          props: {
            image: image ??? null,
            objectFit: null,
            aspectRatio: 'auto',
            renderPlainImage: true,
            caption: props.caption ??? null,
            lazy: props.lazy
          },
          classes: {
            custom: 'w-full h-auto'
          }
        }, withContext = false) }}
      </div>
    {% endfor %}
  </div>
{% endif %}
