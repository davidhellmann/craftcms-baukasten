{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{% set compDefaults = {
  name: 'c-imageGridCalculated',
  images: null,
  lazy: true,
  caption: null,
  classes: {
    root: 'flex flex-col md:flex-row flex-nowrap gap-4 md:gap-8',
    custom: '',
  },
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}

{% if props.images ??? null %}
  <div
    class="{{ props.name }}  {{ props.classes.root }} {{ props.classes.custom }}">
    {% for image in props.images %}
      <div style="--ratio: {{ image.width }} / {{ image.height }}">
        {{ include('_components/image/image.twig', {
          data: {
            image: image ??? null,
            objectFit: null,
            aspectRatio: 'auto',
            renderPlainImage: true,
            caption: props.caption ??? null,
            lazy: props.lazy
          },
          classes: {
            custom: 'w-full h-auto'
          }
        }, withContext = false) }}
      </div>
    {% endfor %}
  </div>
{% endif %}
