{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{% set compDefaults = {
  name: "c-videoVimeo",
  videoId: null,
  autoplay: 0,
  loop: 0,
  showinfo: 0,
  classes: {
    root: "aspect-w-16 aspect-h-9",
    custom: ""
  }
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}

{% if props.videoId %}
  <div class="{{ props.name }} {{ props.classes.root }} {{ props.classes.custom }}">
    <iframe class="lazyload"
      loading="lazy"
      data-src="https://player.vimeo.com/video/{{ props.videoId }}?rel=0&loop={{
      props.loop
      }}&showinfo={{ props.showinfo }}&autoplay={{ props.autoplay }}"></iframe>
  </div>
{% endif %}
