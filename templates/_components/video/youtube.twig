{% set compDefaults = {
  name: "c-videoYoutube",
  videoId: null,
  autoplay: 0,
  loop: 0,
  showinfo: 0,
  classes: {
    root: "aspect-video",
    custom: ""
  }
} %}

{% set props = compDefaults
  | merge(props|default({}))
  | merge({ classes: compDefaults.classes | merge(classes|default({})) })
%}

{% if props.videoId %}
  <div class="{{ props.name }} {{ props.classes.root }} {{ props.classes.custom }}">
    <iframe class="lazyload w-full h-full"
      loading="lazy"
      data-src="https://www.youtube-nocookie.com/embed/{{ props.videoId }}?rel=0&loop={{
      props.loop
      }}&showinfo={{ props.showinfo }}&autoplay={{ props.autoplay }}"></iframe>
  </div>
{% endif %}
