{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{% set compDefaults = {
  name: 'c-plainText',
  text: null,
  classes: {
    root: 'block',
    custom: '',
  }
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}

{# Modul #}
{% if props.text %}
  <p class="{{ props.name }} {{ props.classes.root }} {{ props.classes.custom }}">
    {{ props.text | nl2br | raw }}
  </p>
{% endif %}
