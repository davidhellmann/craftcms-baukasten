{% set compDefaults = {
  name: 'plain-text',
  text: null,
  classes: {
    root: 'block',
    custom: '',
  }
} %}

{% set props = compDefaults
  | merge(props|default({}))
  | merge({ classes: compDefaults.classes | merge(classes|default({})) })
%}

{% if props.text %}
  <p data-slot="{{ props.name }}"
     data-css="{{ props.name }}"
     class="{{ props.name }} {{ props.classes.root }} {{ props.classes.custom }}">
    {{ props.text | nl2br | raw }}
  </p>
{% endif %}
