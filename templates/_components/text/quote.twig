{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{% set compDefaults = {
  name: 'c-quote',
  quote: null,
  source: null,
  sourceUrl: null,
  classes: {
    root: 'space-y-4 md:space-y-8',
    custom: '',
    before: 'relative pl-20 before:inline-flex before:absolute before:top-[14px] before:left-0 before:w-16 before:h-px before:bg-primary-500',
    p: 'font-serif text-5xl italic'
  }
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}

{% if props.quote %}
  <blockquote class="{{ props.name }} {{ props.classes.root }} {{ props.classes.custom }}">
    <p class="{{ props.classes.p }} text-2xl">
      {{ props.quote | nl2br | raw }}
    </p>
    {% if props.source %}
      <footer class="{{ props.classes.before }}">
        {% if props.sourceUrl %}
          <a href="{{ props.sourceUrl }}"><strong>{{ props.source }}</strong></a>
        {% else %}
          <strong>{{ props.source }}</strong>
        {% endif %}
      </footer>
    {% endif %}
  </blockquote>
{% endif %}
