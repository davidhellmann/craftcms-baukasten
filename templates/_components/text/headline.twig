{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{# >>> Comp Defaults #}
{% set compDefaults = {
  name: 'c-headline',
  text: null,
  variantSize: 'h2',
  as: 'h2',
  classes: {
    root: '[text-wrap:balance] font-bold',
    custom: '',
  },
  variants: {
    size: {
      mega: 'text-9xl',
      h1: 'text-4xl',
      h2: 'text-3xl',
      h3: 'text-2xl',
      h4: 'text-xl',
      h5: 'text-lg',
      h6: 'text-base',
    }
  }
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}


{% if props.text %}
  <{{ props.as }} class="{{ props.name }} {{ props.classes.root }} {{ props.variants.size[props.variantSize] }} {{ props.classes.custom }}">
    {{ props.text | nl2br | raw }}
  </{{ props.as }}>
{% endif %}
