{% set compDefaults = {
  name: 'headline',
  text: null,
  variantSize: 'h2',
  as: 'h2',
  classes: {
    root: 'text-balance font-bold',
    custom: '',
  },
  variants: {
    size: {
      mega: 'text-9xl',
      h1: 'text-4xl',
      h2: 'text-3xl',
      h3: 'text-2xl',
      h4: 'text-xl',
      h5: 'text-lg',
      h6: 'text-base',
    }
  }
} %}

{% set props = compDefaults
  | merge(props|default({}))
  | merge({ classes: compDefaults.classes | merge(classes|default({})) })
%}

{% if props.text %}
  <{{ props.as }}  data-slot="{{ props.name }}"
  class="{{ props.classes.root }} {{ props.variants.size[props.variantSize] }} {{ props.classes.custom }}">
    {{ props.text | nl2br | raw }}
  </{{ props.as }}>
{% endif %}
