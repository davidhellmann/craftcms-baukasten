{% set compDefaults = {
  name: 'c-richText',
  html: null,
  classes: {
    root: 'block space-y-4 md:space-y-8',
    custom: '',
  }
} %}

{% set props = compDefaults
  | merge(props|default({}))
  | merge({ classes: compDefaults.classes | merge(classes|default({})) })
%}

{% if props.html %}
  <div class="{{ props.name }} {{ props.classes.root }} {{ props.classes.custom }}">
  {{ props.html | raw }}
  </div>
{% endif %}
