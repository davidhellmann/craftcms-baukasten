{% set compDefaults = {
  name: 'rich-text',
  html: null,
  classes: {
    root: 'block stack-4 md:stack-8',
    custom: '',
  }
} %}

{% set props = compDefaults
  | merge(props|default({}))
  | merge({ classes: compDefaults.classes | merge(classes|default({})) })
%}

{% if props.html %}
  <div data-slot="{{ props.name }}"
       data-css="{{ props.name }}"
       class="{{ props.classes.root }} {{ props.classes.custom }}">
  {{ props.html | raw }}
  </div>
{% endif %}
