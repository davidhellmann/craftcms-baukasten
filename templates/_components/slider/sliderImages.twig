{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{% set compDefaults = {
  name: 'c-sliderImages',
  slides: null,
  aspectRatio: 'aspect-landscape',
  destroyBreakpoint: null,
  classes: {
    root: 'overflow-hidden',
    custom: '',
    swiperSlide: 'swiper-slide',
    swiperWrapper: '',
  },
  variants: {
    aspectRatio: {
      'aspect-landscape': '!w-11/12 sm:!w-5/12 aspect-landscape',
      'aspect-portrait': '!w-11/12 sm:!w-3/12 aspect-portrait',
      'aspect-square': '!w-11/12 sm:!w-3/12 aspect-square',
      'aspect-auto': '!w-11/12 sm:!w-3/12 aspect-auto',
    }
  }
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}

  {# Component #}
<div class="{{ props.name }} {{ props.classes.root }} {{ props.classes.custom }}">
  {# >>> Embed Swiper Holder #}
  {% embed "_components/slider/swiperHolder.twig" with {
    props: {
      slides: props.slides ??? null,
      aspectRatio: props.aspectRatio,
      destroyBreakpoint: props.destroyBreakpoint ??? null,
    },
    classes: props.classes,
    variants: props.variants
  } only %}
    {# >>> Render slides #}
    {% block swiperSlides %}
      {% for image in props.slides %}
        <div class="{{ props.classes.swiperSlide }} {{ props.variants.aspectRatio[props.aspectRatio] }}">
          {{ include('_components/image/image.twig', {
            props: {
              image: image ??? null,
              aspectRatio: props.aspectRatio,
              lazy: false
            }
          }, withContext = false) }}
        </div>
      {% endfor %}
    {% endblock %}
  {% endembed %}
</div>
