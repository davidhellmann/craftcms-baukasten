{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{% set compDefaults = {
  name: 'c-sliderOverflow',
  slides: null,
  classes: {
    root: 'overflow-hidden relative before:absolute before:h-[2px] before:bg-gray-200 before:bottom-0 before:left-0 before:right-0',
    custom: '',
    swiperSlide: 'swiper-slide !w-auto',
    swiperWrapper: '',
  },
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}


  {# Component #}
<div class="{{ props.name }} {{ props.classes.root }} {{ props.classes.custom }}">
  {# >>> Embed Swiper Holder #}
  {% embed "_components/slider/swiperHolder.twig" with {
    props: {
      slides: props.slides ??? null,
      swiperConfig: {
        init: false,
        freeMode: {
          sticky: true
        },
        navigation: {
          nextEl: ".swiper-button-next",
          prevEl: ".swiper-button-prev"
        },
        scrollbar: false,
        slidesPerView: 'auto',
        spaceBetween: 16,
        grabCursor: true,
        simulateTouch: true,
        watchSlidesProgress: true,
        watchSlidesVisibility: true
      }
    },
    classes: props.classes,
  } only %}
    {# >>> Render slides #}
    {% block swiperSlides %}
      {% for slide in props.slides %}
        <div class="{{ props.classes.swiperSlide }}">
          {{ include(
            "_components/button/button.twig",
            {
              props: {
              url: slide.url ??? null,
              text: slide.title ??? null,
              variantStyle: "overflowNav",
              variantSize: "overflowNav"
            }
            },
            withContext = false
          ) }}
        </div>
      {% endfor %}
    {% endblock %}
  {% endembed %}
</div>
