{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{% set compDefaults = {
  name: 'c-header',
  url: siteUrl,
  logoSize: 'sm',
  name: getenv('SITE_NAME'),
  classes: {
    root: 'bg-gray-100',
    custom: '',
    container: 'container py-8 flex items-center',
    homeLink: 'flex items-center',
    h1: 'text-base font-bold ml-4'
  }
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}

<header class="{{ props.name }} {{ props.classes.root }}  {{ props.classes.custom }}">
  <div class=" {{ props.classes.container }}">
    <a href="{{ props.url }}" class="{{ props.classes.homeLink }}">
      {{ include('_components/logo/logo.twig', {
        props: {
          variantSize: props.logoSize ??? 'md'
        },
      }, withContext = false) }}
      <h1 class="{{ props.classes.h1 }}">{{ props.name }}</h1>
    </a>
  </div>
</header>

