{% import '_macros/_macro-mergeProps.twig' as mergeProps %}
{% import '_macros/_macro-signal.twig' as signal %}

{% set compDefaults = {
  name: 'c-tabs',
  variantPosition: 'top',
  activeTab: 1,
  numberOfTabs: null,
  classes: {
    root: 'grid grid-cols-6',
    custom: '',
  },
  variants: {
    position: {
      top: {
        nav: 'col-span-6',
        ul: 'flex flex-col sm:inline-flex sm:flex-row p-0.5 rounded-t-md bg-gray-100',
        li: 'col-span-1 sm:col-auto',
        button: 'a11y-keyboard-focus text-xs font-bold px-4 py-2 w-full text-left sm:w-auto rounded',
        buttonActive: 'bg-white  shadow-sm',
        contentHolder: 'col-span-6 p-4 bg-gray-100',
        content: '',
      },
      left: {
        nav: 'col-span-6 sm:col-span-2 xl:col-span-1',
        ul: 'flex flex-col p-0.5 rounded-t-md sm:rounded-r-none sm:rounded-l-md bg-gray-100',
        li: '',
        button: 'a11y-keyboard-focus text-xs font-bold px-4 py-2 w-full text-left rounded',
        buttonActive: 'bg-white shadow-sm',
        contentHolder: 'col-span-6 sm:col-span-4 xl:col-span-5 p-4 bg-gray-100',
        content: '',
      },
    }
  }
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}

{% set activeTab = signal.name('tabs-active-tab') %}
<div data-signals:{{ activeTab }}="{{ props.activeTab ?? 1 }}"
     class="{{ props.name }} {{ props.classes.root }} {{ props.classes.custom }}">

  <nav class="{{ props.variants.position[props.variantPosition].nav }}">
    <ul class="{{ props.variants.position[props.variantPosition].ul }}">
      {% for i in 1..props.numberOfTabs %}
        {% if block('tab' ~ i) is defined %}
          <li class="{{ props.variants.position[props.variantPosition].li }}">
            <button data-on:click="${{ activeTab }}={{ i }}"
             data-class="{ '{{ props.variants.position[props.variantPosition].buttonActive }}': ${{ activeTab }} === {{i}}}"

            class="{{ props.variants.position[props.variantPosition].button }}">
              {{ block('tab' ~ i) }}
            </button>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </nav>

  <div class="{{ props.variants.position[props.variantPosition].contentHolder }}">
    {% for i in 1..props.numberOfTabs %}
      {% if block('content' ~ i) is defined %}
        <div
          data-class="{ 'block is-active': ${{ activeTab }} === {{i}}, 'hidden': ${{ activeTab }} !== {{i}}}"
          class="{{ props.variants.position[props.variantPosition].content }}">
          {{ block('content' ~ i) }}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>
<pre data-json-signals class="fixed bottom-0 right-0 p-4 text-xs bg-black text-white"></pre>
