{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{% set compDefaults = {
  name: 'c-cardNews',
  variantDirection: 'col',
  image: null,
  aspectRatio: 'aspect-landscape',
  title: null,
  text: null,
  url: null,
  linkText: null,
  lazy: true,
  classes: {
    root: 'rounded-lg overflow-hidden border border-gray-300 group',
    custom: '',
  },
  variants: {
    direction: {
      col: {
        root: 'flex flex-col',
        image: '',
        body: 'px-4 md:px-8 py-4 md:py-8',
        button: 'mt-4 md:mt-8',
      },
      row: {
        root: 'flex flex-col md:grid md:grid-cols-3',
        image: 'md:h-full md:col-span-1',
        body: 'px-4 md:px-8 py-4 md:py-8 md:col-span-2',
        button: 'mt-4 md:mt-8',
      }
    }
  }
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}

{% if props.image and props.title and props.url %}
  <a href="{{ props.url }}"
     class="{{ props.name }} {{ props.classes.root }} {{ props.variants.direction[props.variantDirection].root }} {{ props.classes.custom }}">
    <div class="{{ props.variants.direction[props.variantDirection].image }}">
      {{ include('_components/image/image.twig', {
        props: {
          image: props.image ??? null,
          aspectRatio: props.aspectRatio ??? null,
          objectFit: 'cover',
          renderPlainImage: true,
          lazy: props.lazy,
        }
      }, withContext = false) }}
    </div>
    <div class="{{ props.variants.direction[props.variantDirection].body }}">
      {# >>> Render headline #}
      {{ include('_components/text/headline.twig', {
        props: {
          text: props.title ??? null,
        }
      }, withContext = false) }}

      {# >>> Render text #}
      {% if props.text ??? null %}
        <p>
          {{ include('_components/text/plainText.twig', {
            props: {
              text: props.text ??? null,
            }
          }, withContext = false) }}
        </p>
        {# >>> Render button #}
        {{ include('_components/button/button.twig', {
          props: {
            variantStyle: 'primary',
            variantSize: 'md',
            iconSize: 'sm',
            text: 'Read more',
          },
          classes: {
            custom: props.variants.direction[props.variantDirection].button
          }
        }, withContext = false) }}
      {% endif %}
    </div>
  </a>
{% endif %}
