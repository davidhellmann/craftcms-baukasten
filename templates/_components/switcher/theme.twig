{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{% set compDefaults = {
  name: 'c-switcherTheme',
  variantPosition: 'bottom',
  themes: [
    {name: 'Default', handle: 'default'},
    {name: 'Monochrome', handle: 'monochrome'},
    {name: 'Blue', handle: 'blue'},
    {name: 'Red', handle: 'red'},
    {name: 'Purple', handle: 'purple'},
  ],
  classes: {
    root: 'flex justify-center',
    custom: '',
    button: 'a11y-keyboard-focus rounded-md bg-white px-5 py-2.5 shadow',
    panel: 'absolute right-0 mt-2 w-40 rounded bg-white shadow-md',
    listButton: 'a11y-keyboard-focus block w-full rounded-md px-4 py-2 text-left text-sm hover:bg-gray-50 disabled:text-gray-500'
  },
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}

{# Get initial theme from localStorage or default #}
{% set initialTheme = 'default' %}

<div class="{{ props.name }} {{ props.classes.root }} {{ props.classes.custom }}">
  <div
    data-store='{
      "theme": "{{ initialTheme }}",
      "open": false
    }'
    data-on-load="
      $theme = localStorage.getItem(\"theme\") || \"default\";
      document.documentElement.setAttribute(\"data-theme\", $theme);
    "
    class="relative"
  >
    <!-- Button -->
    <button
      data-on-click="$open = !$open"
      data-bind-aria-expanded="$open"
      type="button"
      class="{{ props.classes.button }}"
    >
      <span data-text="$theme" class="capitalize"></span>
      <span aria-hidden="true">&darr;</span>
    </button>

    <!-- Panel -->
    <div
      data-show="$open"
      data-on-click-outside="$open = false"
      style="display: none;"
      class="{{ props.classes.panel }}"
    >
      <div>
        {% for theme in props.themes %}
          <button
            data-on-click="
              $theme = '{{ theme.handle }}';
              localStorage.setItem('theme', '{{ theme.handle }}');
              document.documentElement.setAttribute('data-theme', '{{ theme.handle }}');
              $open = false;
            "
            class="{{ props.classes.listButton }}" >
            {{ theme.name }}
          </button>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
