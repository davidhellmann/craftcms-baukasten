{% set compDefaults = {
  name: "icon",
  icon: null,
  fill: 'outline',
  variantSize: "sm",
  classes: {
    root: "inline-flex",
    color: "text-current",
    custom: ""
  },
  variants: {
    size: {
      sm: "w-4 h-4",
      md: "w-6 h-6",
      lg: "w-8 h-8",
      xl: "w-12 h-12",
      "2xl": "w-16 h-16"
    }
  }
} %}

{% set props = compDefaults
  | merge(props|default({}))
  | merge({ classes: compDefaults.classes | merge(classes|default({})) })
%}

{% if props.icon %}
  {% set iconFillMethod = props.fill == 'solid' ? '[&>path]:fill-current' : '[&>path]:stroke-current' %}

  {{
  svg("@webroot/dist/images/svg/" ~ props.icon ~ ".svg")|attr({
    'data-slot': props.name,
    class: props.classes.root ~ " " ~ props.classes.color ~ " "
    ~ iconFillMethod ~ " "
    ~ props.variants.size[props.variantSize]
    ~ " "
    ~ props.classes.custom
  })
  }}
{% endif %}
