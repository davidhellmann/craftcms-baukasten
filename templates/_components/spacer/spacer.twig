{% set compDefaults = {
  name: "spacer",
  height: "sm",
  visible: false,
  classes: {
    root: "border-0",
    custom: "",
    visible: "bg-primary-50"
  },
  variants: {
    size: {
      sm: "h-2 md:h-4",
      md: "h-4 md:h-8",
      lg: "h-8 md:h-16",
      xl: "h-16 md:h-32",
      "2xl": "h-32 md:h-64"
    }
  }
} %}

{% set props = compDefaults
  | merge(props|default({}))
  | merge({ classes: compDefaults.classes | merge(classes|default({})) })
%}

<hr data-slot="{{ props.name }}"
    class="{{ props.classes.root }}  {{ props.variants.size[props.height] }}  {{
  props.visible
    ? props.classes.visible
    : ""
  }} {{ props.classes.custom }}" />
