{% set compDefaults = {
  name: 'stack-news',
  headline: null,
  items:  null,
  noLazyImageLoadingCount: null,
  classes: {
    root: 'container grid grid-cols-1 lg:grid-cols-3 lg:gap-12',
    custom: '',
  },
} %}

{% set props = compDefaults
  | merge(props|default({}))
  | merge({ classes: compDefaults.classes | merge(classes|default({})) })
%}

{% if props.items ??? null %}
  <div data-slot="{{ props.name }}"
       class="{{ props.classes.root }}  {{ props.classes.custom }}">
    {% for item in props.items %}
      {{ include('_components/card/cardNews.twig', {
        props: {
          image: item.image.one() ??? null,
          date: item.postDate|date("M Y") ??? null,
          title: item.customTitle ??? item.title ??? null,
          url: item.url ??? null,
          lazy: loop.index > props.noLazyImageLoadingCount
        }
      }, withContext = false) }}
    {% endfor %}
  </div>
{% endif %}
