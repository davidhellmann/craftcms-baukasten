{% set compDefaults = {
  name: 'caption',
  as: 'figcaption',
  title: null,
  text: null,
  source: null,
  sourceUrl: null,
  classes: {
    root: 'text-xs',
    custom: '',
    link: 'underline hover:no-underline'
  }
} %}

{% set props = compDefaults
  | merge(props|default({}))
  | merge({ classes: compDefaults.classes | merge(classes|default({})) })
%}

{% if props.title or props.text %}
  <{{ props.as }} data-slot="{{ props.name }}" class="{{ props.classes.root }}  {{ props.classes.custom }}">
  {# Headline --#}
  {% if props.title ?? null %}
    <strong>{{- props.title ~ ' ' -}}</strong>
  {% endif %}

  {# Caption #}
  {{ include('_components/text/richText.twig', {
    props: {
      html: props.block.text ??? null,
    },
  }, withContext = false) }}
  <p>
    {% if props.source and props.sourceUrl %}
      &mdash;&nbsp;<a class="{{ props.classes.link }}" href="{{ props.sourceUrl }}">{{ props.source }}</a>
    {% elseif props.source ?? null %}
      &mdash;&nbsp;{{ props.source }}
    {% endif %}
  </p>
  </{{ props.as }}>
{% endif %}


