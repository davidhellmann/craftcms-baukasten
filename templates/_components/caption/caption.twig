{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{% set compDefaults = {
  name: 'c-caption',
  element: 'figcaption',
  title: null,
  text: null,
  source: null,
  sourceUrl: null
  classes: {
    root: 'text-xs',
    custom: '',
    link: 'underline hover:no-underline'
  }
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}

{% if props.title or props.text %}
  <{{ props.element }} class="{{ props.name }} {{ props.classes.root }}  {{ props.classes.custom }}">
  {# Headline --#}
  {% if props.title ?? null %}
    <strong>{{- props.title ~ ' ' -}}</strong>
  {% endif %}

  {# Caption #}
  {{ include('_components/text/richText.twig', {
    data: {
      html: props.block.text ??? null,
    },
  }, withContext = false) }}
  <p>
    {% if props.source and props.sourceUrl %}
      &mdash;&nbsp;<a class="{{ props.classes.link }}" href="{{ props.sourceUrl }}">{{ props.source }}</a>
    {% elseif props.source ?? null %}
      &mdash;&nbsp;{{ props.source }}
    {% endif %}
  </p>
  </{{ props.element }}>
{% endif %}


