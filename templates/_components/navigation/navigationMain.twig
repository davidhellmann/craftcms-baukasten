{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{% set compDefaults = {
  name: 'c-navigationMain',
  nodes: null,
  activeNode: null,
  classes: {
    root: '',
    custom: '',
    ul: 'c-navigationMain__list',
    li: 'c-navigationMain__listItem',
    span: 'c-navigationMain__listHeading',
    link: 'a11y-keyboard-focus c-navigationMain__listLink',
    button: 'a11y-keyboard-focus c-navigationMain__listButton',
    subItemsHolder: 'c-navigationMain__subItemsWrapper',
  },
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}

{% if props.nodes ?? null %}
  <nav class="{{ props.name }} {{ props.classes.root }}  {{ props.classes.custom }} js-navigationMain">
    <ul data-store='{
        "activeId": {{ activeNode.id ?? 0 }},
        "activeParentId": {{ (activeNode.parent ?? {}).id ?? 0 }}
      }'
        class="{{ props.classes.ul }}" data-level="1">

      {% nav node in props.nodes %}
        {# >>> Set vars #}
        {% set attributes = '' %}
        {% if node.customAttributes %}
          {% set attributes %}
            {% for attribute in node.customAttributes %}
              {{ attribute.attribute }}="{{ attribute.value }}"
            {% endfor %}
          {% endset %}
        {% endif %}


        <li class="{{ props.classes.li }} {{ node.classes ?? '' }}" data-level="{{ node.level }}"
          {% if node.hasDescendants %}
          data-store='{ "flyoutMenuOpen{{ node.id }}": false }'
          {% endif %}>

          {# >>> Render Link / Submenu Trigger #}
          {% if node.url %}
            {% if node.hasDescendants %}
              <button data-bind-class="($activeId === {{ node.id }} || $activeParentId === {{ node.id }}) ? 'is-active' : ''"
                      class="{{ props.classes.button }}"
                      aria-haspopup="true"
                      data-on-click="
                        $flyoutMenuOpen{{ node.id }} = !$flyoutMenuOpen{{ node.id }};
                        $activeId = {{ node.id }};
                        $activeParentId = {{ node.parent ? node.parent.id : 0 }};
                      "
                      data-bind-aria-expanded="$flyoutMenuOpen{{ node.id }}"
                      data-level="{{ node.level }}" {{ attributes }}>{{- node.title -}}</button>
            {% else %}
              <a href="{{ node.url }}"
                 data-bind-class="$activeId === {{ node.id }} ? 'is-active' : ''"
                 data-on-click="$activeId = {{ node.id }}; $activeParentId = {{ node.parent ? node.parent.id : 0 }};"
                 class="{{ props.classes.link }}" data-level="{{ node.level }}"
                {% if node.newWindow %}
                  target="_blank"
                  rel="noopener"
                {% endif %} {{ attributes }}>{{- node.title -}}</a>
            {% endif %}
            {# >>> Render Heading / Label #}
          {% else %}
            <span class="{{ props.classes.span }}" data-level="{{ node.level }}" {{ attributes }}>
          {{- node.title -}}
          </span>
          {% endif %}

          {% if node.hasDescendants %}
          {% set subItemUls = node.descendants | filter(a => not a.url and a.level == node.level + 1) | length ?? 1 %}
          <div class="{{ props.classes.subItemsHolder }}" data-show="$flyoutMenuOpen{{ node.id }}" data-level="{{ node.level }}"
               data-cols="{{ subItemUls }}" style="display: none;">
            {% endif %}
            {# >>> Render chidlren #}
            {% ifchildren %}
              {% set subItemUls = node.descendants | filter(a => not a.url and a.level == node.level + 1) | length ?? 1 %}
              <ul class="{{ props.classes.ul }}"
                  data-level="{{ node.level + 1 }}" data-cols="{{ subItemUls }}">
                {% children %}
              </ul>
            {% endifchildren %}
            {% if node.hasDescendants %}
          </div>
          {% endif %}
        </li>
      {% endnav %}
    </ul>

  </nav>
{% endif %}
