{# >>> Include macros #}
{% import '_macros/_macro-imageHelper.twig' as imageHelper %}

{% set bgColor %}
  style="background-color: {{- imageData.dominantColor -}}; "
{% endset %}

{# If there is no caption #}
{% if not props.caption %}
  <picture data-slot="{{ props.name }}-picture" class="overflow-hidden {{ props.classes.root }} {{ props.classes.custom }}"
    {% if props.showDominantColor %}{{ bgColor }}{% endif %}>
    {% for source in imageData.sources %}
      {{- imageHelper.renderSource(source[0], source[1], source[2], source[3]) -}}
    {% endfor %}

    {{- imageHelper.renderImage(imageData, props.lazy, props.objectFit) -}}
    {{ include('_components/image/_partials/_nocript.twig', {}, withContext = true) }}
  </picture>

{# If there is a caption #}
{% else %}
  <figure data-slot="{{ props.name }}-figure" class="{{ props.classes.root }} {{ props.classes.custom }}">
    <picture class="overflow-hidden" {% if props.showDominantColor  %}{{ bgColor }}{% endif %}>
      {% for source in imageData.sources %}
        {{- imageHelper.renderSource(source[0], source[1], source[2], source[3]) -}}
      {% endfor %}

      {{- imageHelper.renderImage(imageData, props.lazy, props.objectFit) -}}

      {{ include('_components/image/_partials/_nocript.twig', {}, withContext = true) }}
    </picture>

    {% if props.caption %}
      {# caption #}
      {{ include('_components/caption/caption.twig', {
        props: {
          headline: imageData.caption.headline ??? null,
          text: imageData.caption.text ??? null,
          source: imageData.caption.source ??? null,
          sourceUrl: imageData.caption.sourceUrl ??? null
        },
        classes: {
          custom: 'mt-2'
        }
      }, withContext = false) }}
    {% endif %}
  </figure>
{% endif %}
