{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{% set compDefaults = {
  name: 'c-image',
  image: null,
  aspectRatio: 'aspect-landscape',
  transform: 'auto',
  objectFit: 'cover',
  lazy: true,
  showDominantColor: true,
  calcDominantColor: false,
  noscript: true,
  sources: null,
  caption: null,
  renderPlainImage: false,
  decorativeImage: false,
  classes: {
    root: 'block',
    custom: ''
  }
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}

{# Image #}
{% if props.image ??? null %}
  {% set imageSettings = {
    allowedExtensions: ['png', 'jpg', 'jpeg', 'webp', 'avif'],
    format: 'avif'
  } %}

  {# Image Data Object #}
  {% set imageData = {
    extension: null,
    transformable: null,
    focalpoint: null,
    title: null,
    width: props.image.width,
    height: props.image.height,
    url: props.image.getUrl(),
    noscript: null,
    transforms: null,
    srcset: null,
    filetype: null,
    dominantColor: null,
    placeholder: null,
    caption: null,
    sources: null,
  } %}

  {# Extension #}
  {% set extension = props.image is iterable ? props.image.extension : props.image | split('.') | last %}


  {# If Transformable #}
  {% set isTranformable = extension in imageSettings.allowedExtensions %}


  {# Focal Point / Title / URL #}
  {% set title = props.image.title %}
  {% if props.image.customTitle %}
    {% set title = props.image.customTitle %}
  {% endif %}


  {# Transforms / Srcset #}
  {% if isTranformable %}
    {% set srcsetLegacy = craft.imager.transformImage(props.image, props.transform) %}
    {% set transforms = craft.imager.transformImage(props.image, props.transform, { format: imageSettings.format }) %}
    {% set srcset = craft.imager.srcset(transforms) | trim %}
  {% endif %}


  {# Dominant Color / Placeholder #}
  {% set dominantColor = craft.app.config.custom.dominantColor ??? 'transparent' %}
  {% if props.calcDominantColor
    and not craft.app.config.custom.localDevPerformance
    and isTranformable
    and transforms is defined
    and extension != 'png' %}
    {% set dominantColor = craft.imager.getDominantColor(transforms[0]) %}
  {% endif %}


  {# Caption #}
  {% set caption = null %}
  {% if props.caption %}
    {% set caption = {
      'title': props.image.customTitle ??? null,
      'text': props.image.caption ??? null,
      'source': props.image.source ??? null,
      'sourceUrl': props.image.hyperLink.url ??? null,
    } %}
  {% endif %}



  {# Sources #}
  {% set finaleSources = [] %}
  {% if props.sources | length > 1 %}
    {% for source in props.sources %}
      {% if isTranformable %}
        {% set srcsetLegacySource = craft.imager.transformImage(source[0] ??? null, props.transform) %}
        {% set transformsSource = craft.imager.transformImage(source[0] ??? null, props.transform, { format: imageSettings.format }) %}
        {% set srcsetSource = craft.imager.srcset(transformsSource) | trim %}

        {% set finaleSources = finaleSources|merge([[
          isTranformable and transformsSource is defined ? transformsSource[0].source.extension : extension ??? null,
          srcsetSource ??? null,
          source[1] ??? true,
          source[2] ??? null
        ]]) %}
      {% endif %}
    {% endfor %}
  {% endif %}

  {# >>> Merge Settings #}
  {% set imageData = imageData|merge({
    'extension': extension,
    'transformable': isTranformable,
    'focalpoint': props.image.getFocalpoint('asCss') ??? '50% 50%',
    'title': title,
    'alt': props.decorativeImage ? '' : (props.image.alt ??? title),
    'aspectRatio': props.aspectRatio ??? 'aspect-auto',
    'noscript': "<noscript><img src='#{imageData.url}' alt='#{title}'/></noscript>",
    'transforms': transforms ??? null,
    'srcset': srcset ??? imageData.url,
    'filetype': isTranformable and transforms is defined ? transforms[0].source.extension : extension,
    'dominantColor': dominantColor,
    'placeholder': blurhash(props.image),
    'caption': caption,
    'sources': finaleSources
  }) %}


  {# >>> Render logic #}
  {% if props.renderPlainImage and not props.sources %}

    {# Render Plain Image #}
    {{ include('_components/image/_partials/_renderImage.twig', {}, withContext = true) }}

  {% elseif not props.renderPlainImage and not props.sources %}

    {# Render Figure Element #}
    {{ include('_components/image/_partials/_renderFigure.twig', {}, withContext = true) }}

  {% elseif not props.renderPlainImage and props.sources %}

    {# Render Figure in Picutre #}
    {{ include('_components/image/_partials/_renderPicture.twig', {}, withContext = true) }}

  {% endif %}
{% endif %}
