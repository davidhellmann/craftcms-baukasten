{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{% set compDefaults = {
  name: 'c-accordion',
  firstOpen: true,
  numberOfAccordions: 1,
  classes: {
    root: 'border-b border-gray-300 first:border-t py-4',
    custom: '',
    summary: 'a11y-keyboard-focus list-none cursor-pointer font-bold flex outline-none justify-between items-center rounded',
    contentHolder: 'mt-4',
  }
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}


{% for i in 1..props.numberOfAccordions %}
  <details class="{{ props.name }} {{ props.classes.root }} {{ props.classes.custom }}"
           {% if props.firstOpen and loop.first %}open{% endif %}>
    {% if block('summary' ~ i) is defined %}
      <summary class="{{ props.classes.summary }}">
        {{ block('summary' ~ i) }}

        {{ include('_components/icon/icon.twig', {
          props: {
            icon: 'icons/filled/caret-down',
            variantSize: 'sm',
          },
          classes: {
            color: 'text-black'
          }
        }, withContext = false) }}
      </summary>

      {% if block('content' ~ i) is defined %}
        <div class="{{ props.classes.contentHolder }}">
          {{ block('content' ~ i) }}
        </div>
      {% endif %}
    {% endif %}
  </details>
{% endfor %}
