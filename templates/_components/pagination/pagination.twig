{% import '_macros/_macro-mergeProps.twig' as mergeProps %}

{% set compDefaults = {
  name: "c-pagination",
  prevIcon: "swiper-left",
  nextIcon: "swiper-right",
  classes: {
    root: "mt-4 lg:mt-14",
    custom: ""
  }
} %}

{% set props = mergeProps.merge(compDefaults, props|default({})) | spaceless | json_decode %}


{% if pageInfo and entries and page and pageInfo.totalPages > 1 %}
  <nav class="{{ props.name }} {{ props.classes.root }}" {{ props.classes.custom }}>
    <div class="flex justify-center items-center">
      {% if entries %}
        {% if page > 1 %}
          {# Previous button - decrements page by 1 #}
          <button class="flex bg-primary text-white px-2 py-2 rounded-full"
            aria-label="prev"
            data-on-click="{{ datastar.get('_components/datastar/paginateNews', {
              limit: limit,
              section: section,
              entryUri: entryUri,
              headline: headline
            }) }}"
            data-indicator="page={{ page - 1 }}">
            {{
              include(
                "_components/icon/icon.twig",
                {
                  props: {
                    icon: props.prevIcon,
                    size: "w-8 h-8"
                  }
                },
                withContext = false
              )
            }}
          </button>
        {% endif %}

        <div>
          {% if pageInfo.totalPages <= 6 %}
            {% for i in 1..pageInfo.totalPages %}
              {% if i == page %}
                <span class="inline-block bg-white border-2 border-primary w-9 h-9 text-primary font-sans-medium text-center rounded-full">
                  {{ i }}
                </span>
              {% else %}
                {# Page number button #}
                <a class="cursor-pointer inline-block bg-white border-2 border-transparent w-9 h-9 text-primary text-center rounded-full"
                  data-on-click="{{ datastar.get('_components/datastar/paginateNews', {
                    limit: limit,
                    section: section,
                    entryUri: entryUri,
                    headline: headline
                  }) }}"
                  data-indicator="page={{ i }}">
                  {{ i }}
                </a>
              {% endif %}
            {% endfor %}
          {% else %}
            {% set range = pageInfo.getRange(pageInfo.currentPage - 2, pageInfo.currentPage + 2) %}
            {% if (range|first) != 1 %}
              <a class="cursor-pointer inline-block bg-white border-2 border-transparent w-9 h-9 text-primary text-center rounded-full"
                data-on-click="{{ datastar.get('_components/datastar/paginateNews', {
                  limit: limit,
                  section: section,
                  entryUri: entryUri,
                  headline: headline
                }) }}"
                data-indicator="page=1">
                1
              </a>
              {% if (range|first) > 2 %}
                ...
              {% endif %}
            {% endif %}
            {% for i in (range|first)..(range|last) %}
              {% if i == page %}
                <span class="inline-block bg-white border-2 border-primary w-9 h-9 text-primary font-sans-medium text-center rounded-full">
                  {{ i }}
                </span>
              {% else %}
                {# Page number button in range #}
                <a class="cursor-pointer inline-block bg-white border-2 border-transparent w-9 h-9 text-primary text-center rounded-full"
                  data-on-click="{{ datastar.get('_components/datastar/paginateNews', {
                    limit: limit,
                    section: section,
                    entryUri: entryUri,
                    headline: headline
                  }) }}"
                  data-indicator="page={{ i }}">
                  {{ i }}
                </a>
              {% endif %}
            {% endfor %}
            {% if (range|last) < pageInfo.totalPages - 2 %}
              ...
              <a class="cursor-pointer inline-block bg-white border-2 border-transparent w-9 h-9 text-primary text-center rounded-full"
                data-on-click="{{ datastar.get('_components/datastar/paginateNews', {
                  limit: limit,
                  section: section,
                  entryUri: entryUri,
                  headline: headline
                }) }}"
                data-indicator="page={{ pageInfo.totalPages }}">
                {{ pageInfo.totalPages }}
              </a>
            {% endif %}
          {% endif %}
        </div>

        {% if page < pageInfo.totalPages %}
          {# Next button - increments page by 1 #}
          <button class="flex bg-primary text-white px-2 py-2 rounded-full"
            aria-label="next"
            data-on-click="{{ datastar.get('_components/datastar/paginateNews', {
              limit: limit,
              section: section,
              entryUri: entryUri,
              headline: headline
            }) }}"
            data-indicator="page={{ page + 1 }}">
            {{
              include(
                "_components/icon/icon.twig",
                {
                  props: {
                    icon: props.nextIcon,
                    size: "w-8 h-8"
                  }
                },
                withContext = false
              )
            }}
          </button>
        {% endif %}
      {% endif %}
    </div>
  </nav>
{% endif %}
