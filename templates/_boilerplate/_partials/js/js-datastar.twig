<script>
  function waitForDatastar(){
    if(typeof window.Datastar !== "undefined"){
      // Datastar Event Handling
      if ('loading' in HTMLImageElement.prototype) {
        document.addEventListener('datastar:core:settled', function (e) {
          // Trigger Lazyloading Again after Datastar updates
          document.querySelectorAll(window.LazyImageSelector).forEach(function (lazyImage) {
            window.LazyImageObserver.observe(lazyImage);
          });
        });
      }

      // Add CSS classes for loading states
      document.addEventListener('datastar:core:fetch', function (e) {
        document.documentElement.classList.add('datastar-loading')
        document.documentElement.classList.remove('datastar-settled')
        document.documentElement.classList.remove('datastar-error')
      });

      document.addEventListener('datastar:core:settled', function (e) {
        document.documentElement.classList.add('datastar-settled')
        document.documentElement.classList.remove('datastar-loading')
      });

      document.addEventListener('datastar:core:error', function (e) {
        document.documentElement.classList.add('datastar-error')
        document.documentElement.classList.remove('datastar-loading')
        document.documentElement.classList.remove('datastar-settled')
      });
    } else {
      setTimeout(waitForDatastar, 250);
    }
  }

  waitForDatastar();
</script>
