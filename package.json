{
  "name": "craftcms-baukasten",
  "version": "5.0.0",
  "type": "module",
  "description": "A drop-in buildchain for using Vite in your Craft CMS plugins or modules",
  "author": {
    "email": "david@hellmann.io",
    "name": "David Hellmann",
    "url": "https://davidhellmann.com"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@tailwindcss/vite": "^4.1.17",
    "clipboard": "^2.0.11",
    "lazysizes": "^5.3.2",
    "lightgallery": "^2.9.0",
    "lodash-es": "^4.17.21",
    "prismjs": "^1.30.0",
    "swiper": "^12.0.3",
    "typeface-jetbrains-mono": "^2.0.1",
    "typeface-lato": "^1.1.13",
    "typeface-merriweather": "^1.1.13"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/alpinejs": "^3.13.11",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-legacy": "^7.2.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-critical": "^1.0.15",
    "stylelint": "^16.25.0",
    "stylelint-config-recommended": "^17.0.0",
    "stylelint-config-tailwindcss": "^1.0.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-favicon2": "^1.1.5",
    "vite-plugin-manifest-sri": "^0.2.0",
    "vite-plugin-restart": "^2.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:update": "pnpm i && composer install && pnpm build",
    "build": "pnpm lint && vite build",
    "lint": "pnpm lint:ts && pnpm lint:js && pnpm lint:css",
    "lint:ts": "tsc --noEmit",
    "lint:js": "eslint './src/**/*.{js,ts}' './templates/**/*.{js,ts}' --fix",
    "lint:css": "stylelint './src/**/*.css' './templates/**/*.css' --fix",
    "upgrade-interactive": "pnpm update --interactive",
    "ui": "pnpm upgrade-interactive",
    "prepare": "husky"
  },
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.mjs",
    "require": "./dist/index.js"
  }
}
