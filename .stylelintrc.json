{
  "extends": [
    "stylelint-config-tailwindcss"
  ],
  "ignoreFiles": ["./src/public/css/**/*.css"],
  "rules": {
    "at-rule-no-unknown": [ true, {
      "ignoreAtRules": [
        "apply",
        "extends",
        "layer",
        "screen",
        "responsive",
        "tailwind",
        "source",
        "utility",
        "custom-variant",
        "theme"
      ]
    }],
    "function-no-unknown": null,
    "block-no-empty": null
  }
}
